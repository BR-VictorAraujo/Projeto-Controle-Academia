# Ambiente virtual
venv/

# Variáveis de ambiente
.env

# Cache Python
__pycache__/
*.pyc
*.pyo

# DLLs - exceto biometria
*.dll
!biometria/*.dll
!biometria/libwinpthread-1.dll

# Banco de dados local
*.db
*.sqlite3

# Arquivos de alunos
app/static/documentos/
app/static/fotos/

# FingerPoint - configuracao local (senha do banco e api_token) e logs
biometria/bio_config.json
biometria/logs/

# Instalador: saida do ISCC e instalador do Python embutido
installer/python/
installer/saida/

# Termo LGPD preenchido (dados da academia): fica so local, nao vai para o Git.
# O build.ps1 usa os arquivos do disco, entao o instalador continua com o termo.
docs/lgpd/termo/termo_*.txt
migrations/*_termo_*.sql
